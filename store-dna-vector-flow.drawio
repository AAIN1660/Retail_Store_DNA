<mxfile host="app.diagrams.net" modified="2026-07-19T05:11:00.000Z" agent="Cursor" version="24.7.17" editor="draw.io">
  <diagram id="store-dna-stepwise" name="Store DNA Step by Step">
    <mxGraphModel dx="1400" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Store DNA — Step-by-Step Walkthrough&#xa;How many row embeddings become ONE final vector per store" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1040" height="50" as="geometry" />
        </mxCell>
        <mxCell id="howto" value="Read TOP → BOTTOM. Left box = what the pipeline does. Right box = concrete example with USR-001 and USR-002." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="70" width="1040" height="30" as="geometry" />
        </mxCell>

        <!-- Column headers -->
        <mxCell id="hdr_what" value="WHAT HAPPENS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="hdr_ex" value="EXAMPLE (follow USR-001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="620" height="36" as="geometry" />
        </mxCell>

        <!-- ========== STEP 1 ========== -->
        <mxCell id="s1" value="STEP 1 — Start with curated CSV rows&#xa;&#xa;Each Excel sheet becomes a CSV.&#xa;Every row has a row ID and a store_id.&#xa;Many rows can belong to the same store." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s1e" value="stg_reviews.csv&#xa;&#xa;REV-USR-001-SITE-001  →  store_id = USR-001&#xa;REV-USR-001-SITE-002  →  store_id = USR-001&#xa;REV-USR-002-SITE-001  →  store_id = USR-002&#xa;&#xa;stg_news.csv&#xa;NEWS-USR-001-004      →  store_id = USR-001&#xa;NEWS-USR-002-010      →  store_id = USR-002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="170" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 2 ========== -->
        <mxCell id="s2" value="STEP 2 — Embed each ROW separately (Stage 3)&#xa;&#xa;Each CSV row becomes one Azure AI Search document.&#xa;Document stores: id, source_id, store_id, modality, content_vector.&#xa;Nothing is pooled yet — USR-001 still has multiple documents." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2e" value="Azure Search documents created:&#xa;&#xa;Doc A: modality=reviews, store_id=USR-001, source_id=REV-USR-001-SITE-001, vector=v1&#xa;Doc B: modality=reviews, store_id=USR-001, source_id=REV-USR-001-SITE-002, vector=v2&#xa;Doc C: modality=reviews, store_id=USR-002, source_id=REV-USR-002-SITE-001, vector=v3&#xa;Doc N1: modality=news,   store_id=USR-001, source_id=NEWS-USR-001-004,     vector=n1&#xa;Doc N2: modality=news,   store_id=USR-002, source_id=NEWS-USR-002-010,     vector=n2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="330" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 3 ========== -->
        <mxCell id="s3" value="STEP 3 — FILTER by modality (Stage 4 start)&#xa;&#xa;Fetch only one signal type at a time.&#xa;Filter used:  modality eq 'reviews'&#xa;&#xa;This keeps reviews, news, products, etc. separate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3e" value="Filter: modality = reviews&#xa;&#xa;Returned docs:&#xa;  ✓ Doc A  (reviews, USR-001)&#xa;  ✓ Doc B  (reviews, USR-001)&#xa;  ✓ Doc C  (reviews, USR-002)&#xa;&#xa;NOT returned: Doc N1, Doc N2  (they are news)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 4 ========== -->
        <mxCell id="s4" value="STEP 4 — SEGREGATE by store_id (the key step)&#xa;&#xa;Inside the filtered review docs, put each vector into&#xa;a bucket keyed by store_id.&#xa;&#xa;This is how stores stay separate from each other." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4e" value="Buckets after grouping by store_id:&#xa;&#xa;bucket[&quot;USR-001&quot;] = [v1, v2]     ← Docs A and B&#xa;bucket[&quot;USR-002&quot;] = [v3]         ← Doc C only&#xa;&#xa;USR-001 and USR-002 never share a bucket." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=12;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="660" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 5 ========== -->
        <mxCell id="s5" value="STEP 5 — Mean-pool inside each store bucket&#xa;&#xa;Average all vectors in a bucket into ONE vector.&#xa;Result: one reviews vector per store.&#xa;Repeat Steps 3–5 for news, reports, products, ops_weekly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s5e" value="After mean-pooling:&#xa;&#xa;reviews_USR-001 = mean(v1, v2)   →  one 3072-d vector&#xa;reviews_USR-002 = mean(v3)       →  one 3072-d vector&#xa;&#xa;Then for news:&#xa;news_USR-001 = mean(n1)&#xa;news_USR-002 = mean(n2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="820" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a5" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 6 ========== -->
        <mxCell id="s6" value="STEP 6 — Save one matrix per modality&#xa;&#xa;Each .npz file stores:&#xa;  store_ids = [USR-001, USR-002, ...]&#xa;  vectors   = [vec_for_row0, vec_for_row1, ...]&#xa;&#xa;Row index aligns store_id to its vector." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s6e" value="reviews_vectors.npz&#xa;  store_ids[0] = USR-001 , vectors[0] = reviews_USR-001&#xa;  store_ids[1] = USR-002 , vectors[1] = reviews_USR-002&#xa;&#xa;news_vectors.npz&#xa;  store_ids[0] = USR-001 , vectors[0] = news_USR-001&#xa;  store_ids[1] = USR-002 , vectors[1] = news_USR-002&#xa;&#xa;(same for reports, products, ops_weekly, structured_ops)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="980" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a6" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 7 ========== -->
        <mxCell id="s7" value="STEP 7 — Align all modalities to the same row order&#xa;&#xa;Make sure row 0 is USR-001 in EVERY modality matrix.&#xa;Make sure row 1 is USR-002 in EVERY modality matrix.&#xa;&#xa;Missing modality for a store → zero vector in that slot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s7e" value="Aligned row 0 = USR-001&#xa;&#xa;reviews[0]        = reviews_USR-001&#xa;news[0]            = news_USR-001&#xa;reports[0]         = reports_USR-001&#xa;products[0]        = products_USR-001&#xa;ops_weekly[0]      = ops_weekly_USR-001&#xa;structured_ops[0]  = structured_ops_USR-001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="1150" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a7" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 8 ========== -->
        <mxCell id="s8" value="STEP 8 — Concatenate modalities for the SAME store (Stage 5)&#xa;&#xa;Join modality vectors side-by-side (axis=1).&#xa;This is HORIZONTAL fusion on one store row.&#xa;&#xa;Stores are NOT mixed — only modalities for that store are combined." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1310" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s8e" value="final_USR-001 =&#xa;  [ reviews_USR-001 | news_USR-001 | reports_USR-001&#xa;  | products_USR-001 | ops_weekly_USR-001 | structured_ops_USR-001 ]&#xa;&#xa;final_USR-002 =&#xa;  [ reviews_USR-002 | news_USR-002 | reports_USR-002&#xa;  | products_USR-002 | ops_weekly_USR-002 | structured_ops_USR-002 ]&#xa;&#xa;→ still TWO separate final vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="700" y="1310" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a8" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s8" target="s9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== STEP 9 ========== -->
        <mxCell id="s9" value="STEP 9 — Final Store DNA output&#xa;&#xa;Save one fingerprint per store.&#xa;Upload one Azure Search document per store for peer similarity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1480" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s9e" value="store_dna_vectors.npz&#xa;&#xa;store_ids = [USR-001, USR-002, ...]&#xa;vectors   = [final_USR-001, final_USR-002, ...]&#xa;&#xa;100 stores → 100 final fingerprint vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=12;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="1480" width="620" height="110" as="geometry" />
        </mxCell>

        <!-- ========== SUMMARY BOX ========== -->
        <mxCell id="sum_title" value="REMEMBER THESE 3 RULES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="1280" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sum1" value="1. FILTER&#xa;&#xa;modality = reviews&#xa;(or news / reports / products / ops)&#xa;&#xa;Keeps signal types apart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sum2" value="2. SEGREGATE&#xa;&#xa;group by store_id&#xa;bucket[USR-001] = [v1, v2]&#xa;&#xa;Keeps stores apart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="1690" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sum3" value="3. FUSE&#xa;&#xa;concat modalities for SAME store row&#xa;final_USR-001 = [rev | news | ...]&#xa;&#xa;Combines signals, not stores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="1690" width="400" height="130" as="geometry" />
        </mxCell>

        <!-- Full USR-001 trace -->
        <mxCell id="trace" value="FULL TRACE FOR USR-001 ONLY&#xa;&#xa;Input rows: REV-USR-001-SITE-001, REV-USR-001-SITE-002, NEWS-USR-001-004 (+ reports/products/ops rows)&#xa;→ Stage 3 stores them as separate docs with store_id=USR-001&#xa;→ Stage 4 filter modality=reviews → bucket USR-001=[v1,v2] → mean → reviews_USR-001&#xa;→ Stage 4 filter modality=news    → bucket USR-001=[n1]    → mean → news_USR-001&#xa;→ Stage 5 concat: final_USR-001 = [reviews_USR-001 | news_USR-001 | reports_USR-001 | products_USR-001 | ops_weekly_USR-001 | structured_ops_USR-001]&#xa;→ Result: ONE Store DNA fingerprint for USR-001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1860" width="1280" height="160" as="geometry" />
        </mxCell>

        <!-- Complete sheet and column reference -->
        <mxCell id="cols_title" value="ALL SHEETS AND COLUMNS USED TO BUILD THE VECTORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2060" width="1280" height="38" as="geometry" />
        </mxCell>
        <mxCell id="cols_note" value="Important: raw columns are joined into embed_text within each row. Azure OpenAI converts that text into a 3072-d vector. At final fusion, the VECTORS are concatenated—not the original text columns." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2110" width="1280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="cols_reviews" value="REVIEWS&#xa;Source: customer_reviews sheet → stg_reviews.csv&#xa;Row ID: review_id | Group key: store_id | Modality: reviews&#xa;&#xa;Columns joined into embed_text:&#xa;store_id + source + sentiment + review_text&#xa;&#xa;Example: Store USR-001 | Source: sitejabber | Sentiment: negative | &lt;review text&gt;&#xa;Output after pooling: reviews_USR-001 (3072 dimensions)&#xa;&#xa;Not embedded here: rating, review_date, complaint_tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2190" width="400" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cols_news" value="NEWS&#xa;Source: local_news sheet → stg_news.csv&#xa;Row ID: news_id | Group key: store_id | Modality: news&#xa;&#xa;Columns joined into embed_text:&#xa;store_id + city + state + published_date + headline + summary + demand_impact&#xa;&#xa;Example: Store USR-001 | Austin, TX | Date: ... | Headline: ... | Summary: ... | Impact: ...&#xa;Output after pooling: news_USR-001 (3072 dimensions)&#xa;&#xa;Not embedded here: news_id, event_type, source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="2190" width="400" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cols_reports" value="OPERATIONAL REPORTS&#xa;Source: operational_reports sheet → stg_reports.csv&#xa;Row ID: report_id | Group key: store_id | Modality: reports&#xa;&#xa;Columns joined into embed_text:&#xa;store_id + report_id + report_date + report_type + severity + issue_category + status + reported_by + description&#xa;&#xa;Output after pooling: reports_USR-001 (3072 dimensions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2190" width="400" height="205" as="geometry" />
        </mxCell>

        <mxCell id="cols_products" value="PRODUCTS&#xa;Source: product_descriptions sheet → stg_products.csv&#xa;Row ID: sku_id | Group key: store_id | Modality: products&#xa;&#xa;Columns joined into embed_text:&#xa;store_id + sku_id + category + product_name + description + attributes + brand_type + price_tier + unit_price + pack_size + aisle_zone + facings + weekly_units_sold + margin_pct + in_stock + vendor&#xa;&#xa;Output after pooling: products_USR-001 (3072 dimensions)&#xa;Not embedded here: upc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2425" width="400" height="225" as="geometry" />
        </mxCell>
        <mxCell id="cols_ops_embed" value="OPS WEEKLY — TEXT EMBEDDING&#xa;Source: operations_weekly sheet → fact_operations_weekly.csv&#xa;Row ID: ops_row_id = store_id + week_end_date&#xa;Group key: store_id | Modality: ops_weekly&#xa;&#xa;Columns joined into embed_text:&#xa;store_id + week_end_date + labor_hours + shrink_pct + oos_rate + fulfillment_rate + customer_complaints&#xa;&#xa;Output after pooling: ops_weekly_USR-001 (3072 dimensions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="2425" width="400" height="225" as="geometry" />
        </mxCell>
        <mxCell id="cols_ops_struct" value="STRUCTURED OPS — NUMERIC VECTOR&#xa;Source: same fact_operations_weekly.csv&#xa;Group key: store_id | Modality: structured_ops&#xa;&#xa;Numeric KPI columns:&#xa;labor_hours + shrink_pct + oos_rate + fulfillment_rate + customer_complaints&#xa;&#xa;Processing: mean across weeks per store → fill missing values → z-score across stores&#xa;&#xa;Output: structured_ops_USR-001 (5 dimensions)&#xa;No Azure OpenAI text embedding is used for this block." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2425" width="400" height="225" as="geometry" />
        </mxCell>

        <mxCell id="concat_title" value="EXACT FINAL CONCATENATION FOR ONE STORE (USR-001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2690" width="1280" height="38" as="geometry" />
        </mxCell>
        <mxCell id="concat_blocks" value="reviews_USR-001&#xa;3072 dims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2750" width="185" height="70" as="geometry" />
        </mxCell>
        <mxCell id="concat_news" value="news_USR-001&#xa;3072 dims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="2750" width="185" height="70" as="geometry" />
        </mxCell>
        <mxCell id="concat_reports" value="reports_USR-001&#xa;3072 dims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="2750" width="185" height="70" as="geometry" />
        </mxCell>
        <mxCell id="concat_products" value="products_USR-001&#xa;3072 dims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="2750" width="185" height="70" as="geometry" />
        </mxCell>
